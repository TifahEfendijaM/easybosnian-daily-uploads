{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","project","date","theme","words","design_palette","cards","caption","hashtags","sources","private_review"],
  "properties":{
    "schema_version":{"const":1},
    "batch_id":{"type":"string","pattern":"^(b-[a-f0-9]{32}|legacy-[0-9]{4}-[0-9]{2}-[0-9]{2})$"},
    "background_source":{"$ref":"#/$defs/photo_source"},
    "background_sources":{"description":"Trusted per-card overrides for retained original photos.","type":"object","additionalProperties":false,"minProperties":1,"properties":{"quiz":{"$ref":"#/$defs/photo_source"},"lesson":{"$ref":"#/$defs/photo_source"},"word":{"$ref":"#/$defs/photo_source"}}},
    "rendered_sources":{"description":"Trusted expiring finished-card snapshots for exact same_image&design reuse; never model-selected.","type":"object","additionalProperties":false,"minProperties":1,"properties":{"quiz":{"$ref":"#/$defs/rendered_source"},"lesson":{"$ref":"#/$defs/rendered_source"},"word":{"$ref":"#/$defs/rendered_source"}}},
    "bosnian_level":{"enum":["A1","A2","B1","B2","C1","C2"]},
    "project":{"const":"tifahefendijam-easybosnian-daily-uploads-v1"},
    "date":{"type":"string","format":"date"},
    "theme":{"type":"object","additionalProperties":false,"required":["name","equivalence_keys"],"properties":{"name":{"$ref":"#/$defs/text"},"equivalence_keys":{"$ref":"#/$defs/keys"}}},
    "words":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["lemma","equivalence_keys"],"properties":{"lemma":{"$ref":"#/$defs/text"},"equivalence_keys":{"$ref":"#/$defs/keys"},"bosnian_level":{"enum":["A1","A2","B1","B2","C1","C2",null]}}}},
    "design_palette":{"enum":["gold-cream","forest-cream","terracotta-sand","blue-ice","rose-ivory","lavender-pearl","mint-linen","coral-cream","slate-silver","plum-blush","charcoal-lemon","burgundy-oat","olive-stone","indigo-mist","copper-linen","teal-seaglass","aubergine-apricot","espresso-almond","graphite-chalk","cobalt-peach","ochre-parchment","pine-rose","royal-blue-sun","emerald-lime","ruby-cream","violet-citrus","ocean-tangerine","magenta-porcelain","scarlet-vanilla","peacock-coral","sapphire-lime","grape-lemon","paprika-aqua","ultramarine-orchid","cherry-lime","petrol-cyan"]},
    "cards":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/card"}},
    "caption":{"type":"string","minLength":10,"maxLength":1600},
    "caption_language":{"enum":["en","bs"]},
    "hashtags":{"type":"array","minItems":3,"maxItems":5,"uniqueItems":true,"items":{"type":"string","pattern":"^#[^\\s#]+$","maxLength":60}},
    "sources":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["url","title","supports","checked_at"],"properties":{"url":{"type":"string","format":"uri"},"title":{"$ref":"#/$defs/text"},"supports":{"type":"string","minLength":20,"maxLength":800},"checked_at":{"type":"string","format":"date-time"}}}},
    "private_review":{"type":"object","additionalProperties":false,"required":["correct_option","correct_text","explanation","answer_aliases","identifying_hints","standard_bosnian_checked","sources_checked","semantic_history_checked","no_answer_leak_checked","history_checked_at","reviewed_at","reviewer","notes"],"properties":{
      "language_policy_checked":{"type":"boolean"},
      "quiz_choice_review":{"type":"object","additionalProperties":false,"required":["target","binary","reason"],"properties":{"target":{"enum":[2,3,4]},"binary":{"type":"boolean"},"reason":{"type":"string","minLength":20,"maxLength":400}}},
      "word_replacements":{"type":"array","maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["word_index","requested_word","chosen_word","reason"],"properties":{"word_index":{"enum":[0,1,2]},"cause":{"enum":["spelling_correction","theme_mismatch","invalid_bosnian","history_repeat","word_overlap","unusable_seed"]},"requested_word":{"$ref":"#/$defs/text"},"chosen_word":{"$ref":"#/$defs/text"},"reason":{"type":"string","minLength":20,"maxLength":400}}}},
      "correct_option":{"enum":["A","B","C","D"]},"correct_text":{"$ref":"#/$defs/text"},"explanation":{"type":"string","minLength":10,"maxLength":1000},
      "answer_aliases":{"$ref":"#/$defs/keys"},"identifying_hints":{"$ref":"#/$defs/keys"},
      "standard_bosnian_checked":{"type":"boolean"},"sources_checked":{"type":"boolean"},"semantic_history_checked":{"type":"boolean"},"no_answer_leak_checked":{"type":"boolean"},
      "history_checked_at":{"type":"string","format":"date-time"},"reviewed_at":{"type":"string","format":"date-time"},"reviewer":{"$ref":"#/$defs/text"},"notes":{"type":"string","maxLength":2000}
    }}
  },
  "$defs":{
    "rendered_source":{"type":"object","additionalProperties":false,"required":["cache_id","date","card_sha256","story_sha256","content_sha256","metrics","policy"],"properties":{"cache_id":{"type":"string","pattern":"^b-[a-f0-9]{32}$"},"date":{"type":"string","format":"date"},"card_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"story_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"content_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"metrics":{"type":"object","maxProperties":50},"policy":{"type":"object","maxProperties":6}}},
    "photo_source":{"description":"Trusted wrapper provenance for the exact cached original photographs, not a model design choice.","type":"object","additionalProperties":false,"required":["batch_id","artwork_id"],"properties":{"batch_id":{"type":"string","pattern":"^(b-[a-f0-9]{32}|legacy-[0-9]{4}-[0-9]{2}-[0-9]{2})$"},"artwork_id":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^r-[a-f0-9]{32}$"}]}}},
    "text":{"type":"string","minLength":1,"maxLength":180},
    "keys":{"type":"array","minItems":1,"maxItems":40,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":100}},
    "card":{"type":"object","additionalProperties":false,"required":["kind","word","background_prompt","alt_text"],"properties":{
      "kind":{"enum":["quiz","lesson","word"]},"word":{"$ref":"#/$defs/text"},
      "design_template":{"description":"Deprecated read-only compatibility field; omit from new preparations.","enum":["editorial","framed","notebook","ribbon","split-cards","minimal","rounded","poster"]},
      "background_prompt":{"type":"string","minLength":100,"maxLength":2048},"alt_text":{"type":"string","minLength":10,"maxLength":300},
      "question":{"type":"string","minLength":5,"maxLength":150},
      "question_language":{"enum":["en","bs"]},
      "quiz_format":{"enum":["visual_identification","other"]},
      "options":{"type":"array","minItems":2,"maxItems":4,"items":{"type":"object","additionalProperties":false,"required":["label","text"],"properties":{"label":{"enum":["A","B","C","D"]},"text":{"type":"string","minLength":1,"maxLength":100}}}},
      "body_language":{"enum":["en","bs"]},
      "heading":{"$ref":"#/$defs/text"},"body":{"type":"string","minLength":10,"maxLength":380},"example":{"type":"string","minLength":5,"maxLength":180}
    },"allOf":[
      {"if":{"properties":{"kind":{"const":"quiz"}}},"then":{"required":["question","options"],"not":{"anyOf":[{"required":["heading"]},{"required":["body"]},{"required":["example"]},{"required":["body_language"]}]}}},
      {"if":{"properties":{"kind":{"enum":["lesson","word"]}}},"then":{"required":["heading","body"],"not":{"anyOf":[{"required":["question"]},{"required":["question_language"]},{"required":["options"]},{"required":["quiz_format"]}]}}},
      {"if":{"properties":{"kind":{"const":"word"}}},"then":{"required":["example"]}}
    ]}
  }
}
